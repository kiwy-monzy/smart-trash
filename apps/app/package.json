{
    "name":  "smart-trash-app",
    "private":  true,
    "version":  "0.1.0",
    "type":  "module",
    "scripts":  {
                    "typecheck":  "tsc --noEmit",
                    "android:build":  "tauri android build",
                    "ios:build":  "tauri ios build",
                    "ios:init":  "tauri ios init",
                    "ios:dev":  "tauri ios dev",
                    "desktop:dev":  "powershell -ExecutionPolicy Bypass -File ../../scripts/tauri.ps1 dev",
                    "probe":  "esbuild scripts/probe.ts --bundle --platform=node --format=esm --outfile=scripts/probe.mjs --log-level=warning \u0026\u0026 node scripts/probe.mjs",
                    "desktop:build":  "powershell -ExecutionPolicy Bypass -File ../../scripts/tauri.ps1 build",
                    "build":  "vite build",
                    "app":  "powershell -ExecutionPolicy Bypass -File ../../scripts/run-app.ps1",
                    "android:dev":  "tauri android dev",
                    "dev":  "vite",
                    "proto":  "protoc --proto_path=../../proto --ts_out=src/generated --ts_opt=long_type_string ../../proto/identity.proto ../../proto/auth.proto ../../proto/pickup.proto ../../proto/fleet.proto ../../proto/tracking.proto ../../proto/scheduling.proto ../../proto/routing.proto ../../proto/payment.proto ../../proto/compliance.proto ../../proto/notification.proto ../../proto/geo.proto",
                    "tauri":  "tauri",
                    "preview":  "vite preview",
                    "android:init":  "tauri android init",
                    "pentest":  "node scripts/pentest.mjs"
                },
    "dependencies":  {
                         "@protobuf-ts/grpcweb-transport":  "^2.11.1",
                         "@protobuf-ts/runtime":  "^2.11.1",
                         "@protobuf-ts/runtime-rpc":  "^2.11.1",
                         "@tauri-apps/plugin-geolocation":  "^2.5.0",
                         "@tauri-apps/plugin-haptics":  "^2.4.2",
                         "h3-js":  "^4.5.0",
                         "leaflet":  "^1.9.4"
                     },
    "devDependencies":  {
                            "@protobuf-ts/plugin":  "^2.11.1",
                            "@protobuf-ts/protoc":  "^2.11.1",
                            "@tauri-apps/cli":  "^2.1.0",
                            "@types/leaflet":  "^1.9.22",
                            "esbuild":  "^0.28.2",
                            "typescript":  "^7.0.2",
                            "vite":  "^7.1.0"
                        }
}
