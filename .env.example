# Smart Trash — settings template. Copy to `.env` and adjust.
# Real environment variables always override these values.

# --- Logging ----------------------------------------------------------------
RUST_LOG=info

# --- RPC (smarttrash-server): one port for all 8 services -------------------
RPC_ADDR=127.0.0.1:50051
RPC_URL=http://127.0.0.1:50051

# --- HTTP gateway -----------------------------------------------------------
GATEWAY_ADDR=127.0.0.1:8080

# --- Authentication ---------------------------------------------------------
# HMAC secret for session tokens (gateway -> RPC). At least 32 characters.
# Generate a fresh one per deployment; rotating it signs everybody out.
AUTH_TOKEN_SECRET=dev-only-secret-change-me-0123456789abcdef
# DEVELOPMENT ONLY: demo sign-in for the static prototypes. Handing out a
# session without a password must never reach a real network.
AUTH_DEMO_LOGIN=true
# Session lifetime, seconds (default 8h, capped at 30 days).
AUTH_TOKEN_TTL_SECONDS=28800
# Requests per minute per client IP on /api/* (0 disables the limiter).
RATE_LIMIT_PER_MINUTE=600

# --- Database (PostgreSQL + Diesel) ------------------------------------------
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/smarttrash
# DB_MAX_CONNECTIONS=10
# DB_RUN_MIGRATIONS=true

# --- gRPC reflection ----------------------------------------------------------
# Lets grpcurl/Postman list the services without a .proto file (no token needed).
# Set to false to hide the API shape in production.
GRPC_REFLECTION=true
